<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>MoodMeal | Prediction</title>
        <link rel="stylesheet" href="/style.css">
    </head>
    <body>
        <div class="container">
          <div class="result-box">
            <h1>Your Mood Result 🎉</h1>
      
            <p class="user-input"><strong>Your Input:</strong> "<%= userInput %>"</p>
            <p class="mood">Mood: <%= mood %></p>
            <p class="meal">Recommended Meal: <%= meal %></p>
      
            <% if (recipe && ytLink) { %>
              <div class="recipe-section">
                <h2>🍽️ Recipe:</h2>
                <p class="recipe-text"><%= recipe %></p>
      
                <a href="<%= ytLink %>" target="_blank" class="try-again ytLink">
                  📺 Watch on YouTube
                </a>
              </div>
            <% } %>

            <button class="try-again" style="border: none; font-size: 16.5px; cursor: pointer;">⬅️ Previous Prompts</button>
      
            <a href="/" class="try-again">🔄 Try Again</a>
          </div>
        </div>
        <div class="prompts">
          <img src="/images/close.png" alt="close" height="50px" width="50px" class="close">
          <div class="pp">
            <% for(let i = 0; i < prompts.length; i++) { %>
              <h3><%= prompts[i] %></h3>
            <% } %>
          </div>
        </div>

        <script>
          let btn = document.querySelector("button");
          let prompt = document.querySelector(".prompts");
          let closing = document.querySelector(".close");

          btn.addEventListener('click', ()=>{
            prompt.classList.add("active");
          })

          closing.addEventListener('click', ()=>{
            prompt.classList.remove("active");
          })
          
        </script>
      </body>
      
</html>